# Settings for vox-update.sh (automatic deploys). Copy to /etc/vox/deploy.env, owned by root,
# mode 600. Never commit a filled-in copy.

# The repository whose releases are installed.
VOX_REPO=johnbellone/vox.fail

# Only if the repository is private: a fine-grained token with read access to its contents
# (releases) and nothing else.
GITHUB_TOKEN=

# 1 to also check the bundle's build provenance with `gh attestation verify` (needs gh): proof
# that GitHub Actions in this repository built it, beyond the checksum beside it.
VOX_VERIFY_ATTESTATION=0

# Purge Cloudflare's cache after a deploy: the zone ID of vox.fail (its Overview page) and an API
# token limited to Zone → Cache Purge on that zone. Empty: no purge (the edge keeps old files up to
# five minutes).
CF_ZONE=
CF_TOKEN=
