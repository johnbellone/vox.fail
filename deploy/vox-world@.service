# One world per instance: vox-world@void, vox-world@yard, vox-world@islands.
# Each reads /etc/vox/<name>.env for PORT and SEED.
[Unit]
Description=Vox world %i
After=network-online.target vox-directory.service

[Service]
User=vox
WorkingDirectory=/opt/vox
EnvironmentFile=/etc/vox/%i.env
# VOX_WORLD_SECRET, the same as the directory's
EnvironmentFile=/etc/vox/worlds.env
ExecStart=/opt/vox/bin/vox-server --listen 127.0.0.1:${PORT} --db /var/lib/vox/%i.db --name %i --seed ${SEED} --directory-key /var/lib/vox/directory.key.pub --directory-url http://127.0.0.1:7700
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vox
Restart=on-failure
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
