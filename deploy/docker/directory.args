# vox-directory's flags on Cloudflare, one per line (vox-supervise reads them). The same as
# deploy/vox-directory.service, except it listens on every address: the Durable Object reaches
# the container from outside it, and the edge Worker refuses /api/world/ and /api/host/.
--listen
0.0.0.0:7700
--db
/var/lib/vox/directory.db
--key
/var/lib/vox/directory.key
--secure
--behind-proxy
--public-url
https://vox.fail
--steam
--world
void=The Void=/w/7780/ws
--world
yard=The Yard=/w/7781/ws
--world
islands=The Islands=/w/7782/ws
--world
sea=The Dark Sea=/w/7783/ws
--world
orbit=Orbit=/w/7784/ws
--instances-at
http://127.0.0.1:7790
