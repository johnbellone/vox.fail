#!/usr/bin/env bash
# Runs vox.fail's two servers in one container, as Litestream's child (start.sh): the directory
# first (it writes directory.key.pub, which vox-host reads at start), then vox-host. If either
# stops, the other is stopped too and this exits, so Litestream syncs and the container ends.
# SIGTERM or SIGINT stops both; each saves before it exits.
#
# Flags: one per line in /opt/vox/etc/directory.args and host.args (lines may hold spaces).
set -uo pipefail

ETC="${VOX_ETC:-/opt/vox/etc}"
BIN="${VOX_BIN:-/opt/vox/bin}"
DATA="${VOX_DATA:-/var/lib/vox}"
say() { echo "supervise: $*"; }
# Litestream holds the R2 keys; the servers don't need them
unset LITESTREAM_ACCESS_KEY_ID LITESTREAM_SECRET_ACCESS_KEY

read_args() { # file -> the array named by $2, skipping blank lines and # comments
  local -n out="$2"
  out=()
  while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    out+=("$line")
  done < "$1"
}
read_args "$ETC/directory.args" dir_args
read_args "$ETC/host.args" host_args

pids=()
stop() {
  trap '' TERM INT # a second signal mustn't kill this mid-save and orphan the servers
  say "stopping"
  for p in "${pids[@]}"; do kill -TERM "$p" 2>/dev/null; done
  for p in "${pids[@]}"; do wait "$p" 2>/dev/null; done
  exit "${1:-0}"
}
trap 'stop 0' TERM INT
# a key left from an earlier run (a reused folder) would reach vox-host before the new one
rm -f "$DATA/directory.key.pub"

# A signal during a launch is noted and acted on once the pid is in pids (an ignored signal
# would be inherited by the server, which then couldn't be stopped).
pending=0
launch() {
  trap 'pending=1' TERM INT
  "$@" &
  pids+=($!)
  trap 'stop 0' TERM INT
  [ "$pending" = 0 ] || stop 0
}
launch "$BIN/vox-directory" "${dir_args[@]}"
say "directory started"

# vox-host needs the directory's public key, which the directory writes as it starts
for _ in $(seq 120); do
  [ -s "$DATA/directory.key.pub" ] && break
  kill -0 "${pids[0]}" 2>/dev/null || { say "the directory stopped before it was ready"; stop 1; }
  sleep 0.5
done
[ -s "$DATA/directory.key.pub" ] || { say "no directory.key.pub after a minute"; stop 1; }

launch "$BIN/vox-host" "${host_args[@]}"
say "vox-host started"

# whichever stops first, stop the other
wait -n "${pids[@]}"
code=$?
say "a server stopped (exit $code)"
stop "$code"
