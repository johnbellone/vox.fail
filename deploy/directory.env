# /etc/vox/directory.env (root-owned, mode 600): the sign-in sites' secrets.
#
# Discord: discord.com/developers/applications → your app → OAuth2. Add the redirect
# https://vox.fail/auth/discord/return, then copy the client ID and secret here.
VOX_DISCORD_CLIENT_ID=
VOX_DISCORD_CLIENT_SECRET=
# Steam needs nothing to sign people in. With a Steam Web API key
# (steamcommunity.com/dev/apikey, domain vox.fail), new accounts take their Steam name;
# without one they're called "Steam player" (then "Steam player 2", ...).
VOX_STEAM_KEY=
