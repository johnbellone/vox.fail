[Unit]
Description=Vox directory (vox.fail: accounts, characters, pages)
After=network-online.target

[Service]
User=vox
WorkingDirectory=/opt/vox
# Steam and Discord secrets, and the secret worlds report with (see directory.env)
EnvironmentFile=-/etc/vox/directory.env
ExecStart=/opt/vox/bin/vox-directory --listen 127.0.0.1:7700 --db /var/lib/vox/directory.db --key /var/lib/vox/directory.key --secure --behind-proxy --public-url https://vox.fail --steam --world "void=The Void=/w/7780/ws" --world "yard=The Yard=/w/7781/ws" --world "islands=The Islands=/w/7782/ws" --world "sea=The Dark Sea=/w/7783/ws"
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vox
Restart=on-failure

[Install]
WantedBy=multi-user.target
